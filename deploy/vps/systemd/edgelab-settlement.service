[Unit]
Description=Market Edge Lab: bounded settlement-evidence refresh for pending events, then shadow bookkeeping
Documentation=file:///opt/market-edge-lab/app/deploy/vps/README.md
After=network-online.target
Wants=network-online.target
OnFailure=edgelab-alert@%n.service
OnSuccess=edgelab-notify.service

[Service]
Type=oneshot
Slice=edgelab.slice
User=edgelab
Group=edgelab
EnvironmentFile=/etc/market-edge-lab/env
WorkingDirectory=/var/lib/market-edge-lab
# Targeted GET /markets?event_ticker=... for events with open positions that are due only:
# at most 10 events, shared pacer, bounded retries, 120 s deadline. No full-history download.
ExecStart=/opt/market-edge-lab/venv/bin/python -m edge_lab.cli shadow daily --refresh-settlements --max-events 10 --deadline-s 120 --db /var/lib/market-edge-lab/db/edge_lab.sqlite3 --ledger /var/lib/market-edge-lab/ledger/shadow_ledger.sqlite3 --status-dir /var/lib/market-edge-lab-status
TimeoutStartSec=10min
UMask=0077
# Resource caps per run; edgelab.slice caps all edgelab units together (ADR 0012, 0016).
MemoryHigh=192M
MemoryMax=256M
CPUQuota=25%
TasksMax=32
Nice=5
# Filesystem and privilege hardening: writes only its own data and status directories.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/market-edge-lab /var/lib/market-edge-lab-status
