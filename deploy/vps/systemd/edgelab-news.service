[Unit]
Description=Market Edge Lab: news intelligence run every 2 hours (read-only feeds + bounded Kalshi quotes, ADR 0049)
Documentation=file:///opt/market-edge-lab/app/docs/decisions/0049-news-intel-slice.md
After=network-online.target
Wants=network-online.target
OnFailure=edgelab-alert@%n.service

[Service]
Type=oneshot
Slice=edgelab.slice
User=edgelab
Group=edgelab
EnvironmentFile=/etc/market-edge-lab/env
WorkingDirectory=/var/lib/market-edge-lab
# No secrets: every feed and the Kalshi endpoints are public and unauthenticated; no key is loaded.
# One run (EXECUTION_PLAN 2026-11-05): collect the verified feeds (at most 1 GET per feed, at most 60
# feed GETs, conditional GETs, honest User-Agent), refresh quotes of owner-CONFIRMED Kalshi links only
# (at most 120 GETs; the code refuses protected scopes, protected windows and the 10 minutes around the
# KXHIGHNY close tick), drain the dashboard inbox, and write the intel.json heartbeat to the status dir.
# The inbox (/var/lib/market-edge-lab/intel-inbox) lies under the writable data root below.
ExecStart=/opt/market-edge-lab/venv/bin/python -m edge_lab.cli intel --db /var/lib/market-edge-lab/db/edge_lab.sqlite3 run --inbox /var/lib/market-edge-lab/intel-inbox --status-dir /var/lib/market-edge-lab-status
TimeoutStartSec=6min
UMask=0077
MemoryHigh=192M
MemoryMax=256M
CPUQuota=15%
TasksMax=16
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/market-edge-lab /var/lib/market-edge-lab-status
