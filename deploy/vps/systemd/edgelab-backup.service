[Unit]
Description=Market Edge Lab: verified SQLite backups of the evidence DB and shadow ledger (no automatic deletion)
Documentation=file:///opt/market-edge-lab/app/deploy/vps/README.md
After=network-online.target
Wants=network-online.target
OnFailure=edgelab-alert@%n.service

[Service]
Type=oneshot
Slice=edgelab.slice
User=edgelab
Group=edgelab
EnvironmentFile=/etc/market-edge-lab/env
WorkingDirectory=/var/lib/market-edge-lab
# Both stores: the evidence DB and the shadow ledger (the ledger is skipped, not failed,
# until its first run creates it). The ledger copy holds the ledger lock shared with writers.
ExecStart=/opt/market-edge-lab/venv/bin/python -m edge_lab.backup create --kind evidence --db /var/lib/market-edge-lab/db/edge_lab.sqlite3 --out /var/lib/market-edge-lab/backups
ExecStart=/opt/market-edge-lab/venv/bin/python -m edge_lab.backup create --kind ledger --if-exists --db /var/lib/market-edge-lab/ledger/shadow_ledger.sqlite3 --lock-file /var/lib/market-edge-lab/ledger/shadow_ledger.sqlite3.lock --out /var/lib/market-edge-lab/backups/ledger
# Oneshot: the whole run is the start job. On timeout systemd sends SIGTERM, which the
# collector turns into a recorded failed run.
TimeoutStartSec=20min
UMask=0077
# Resource caps: the collector must never starve Chase Upside (ADR 0012).
MemoryHigh=192M
MemoryMax=256M
CPUQuota=25%
TasksMax=32
Nice=5
# Filesystem and privilege hardening: writes only its own data and status directories.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/market-edge-lab /var/lib/market-edge-lab-status
