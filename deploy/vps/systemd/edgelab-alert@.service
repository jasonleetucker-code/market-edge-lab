[Unit]
Description=Market Edge Lab: failure alert for %i
# After recording the failure (last_failure.json), relay it as a fixed-headline push (ADR 0028).
OnSuccess=edgelab-notify.service

[Service]
Slice=edgelab.slice
Type=oneshot
User=edgelab
Group=edgelab
EnvironmentFile=/etc/market-edge-lab/env
ExecStart=/opt/market-edge-lab/app/deploy/vps/alert.sh %i
TimeoutStartSec=60
UMask=0022
MemoryMax=64M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/market-edge-lab-status
