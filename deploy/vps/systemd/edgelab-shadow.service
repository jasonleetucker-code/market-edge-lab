[Unit]
Description=Market Edge Lab: daily EXP-001 shadow bookkeeping from stored evidence (no network, no orders)
Documentation=file:///opt/market-edge-lab/app/deploy/vps/README.md
After=network-online.target
Wants=network-online.target
OnFailure=edgelab-alert@%n.service

[Service]
Type=oneshot
Slice=edgelab.slice
User=edgelab
Group=edgelab
EnvironmentFile=/etc/market-edge-lab/env
WorkingDirectory=/var/lib/market-edge-lab
# Evaluates closed capture days read-only, records simulated decisions/fills, settles from
# stored evidence, writes shadow_daily.json. Exit 3 = INVALID capture day (alerts).
ExecStart=/opt/market-edge-lab/venv/bin/python -m edge_lab.cli shadow daily --db /var/lib/market-edge-lab/db/edge_lab.sqlite3 --ledger /var/lib/market-edge-lab/ledger/shadow_ledger.sqlite3 --status-dir /var/lib/market-edge-lab-status
TimeoutStartSec=10min
UMask=0077
# Resource caps per run; edgelab.slice caps all edgelab units together (ADR 0012, 0016).
MemoryHigh=192M
MemoryMax=256M
CPUQuota=25%
TasksMax=32
Nice=5
# Filesystem and privilege hardening: writes only its own data and status directories.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/market-edge-lab /var/lib/market-edge-lab-status
