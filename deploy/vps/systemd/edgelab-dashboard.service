[Unit]
Description=Market Edge Lab: read-only shadow dashboard on 127.0.0.1:8765 (tailnet-only via Tailscale Serve)
Documentation=file:///opt/market-edge-lab/app/docs/DASHBOARD.md
After=network.target

# Long-running, read-only, loopback-only (ADR 0024). Tailscale Serve on this host proxies
# https://<machine>.<tailnet>.ts.net to it for tailnet devices only. Never Funnel.
# /etc/market-edge-lab/dashboard.env sets EDGE_LAB_TAILSCALE_SERVE_HOST to that exact name.
# Without it the dashboard refuses to start.
[Service]
Type=simple
Slice=edgelab.slice
User=edgelab
Group=edgelab
EnvironmentFile=/etc/market-edge-lab/dashboard.env
WorkingDirectory=/var/lib/market-edge-lab
ExecStart=/opt/market-edge-lab/venv/bin/python -m edge_lab.dashboard --host 127.0.0.1 --port 8765 --db /var/lib/market-edge-lab/db/edge_lab.sqlite3 --ledger /var/lib/market-edge-lab/ledger/shadow_ledger.sqlite3 --status-dir /var/lib/market-edge-lab-status --experiments-root /opt/market-edge-lab/app/experiments --tailscale-serve-host ${EDGE_LAB_TAILSCALE_SERVE_HOST}
Restart=on-failure
RestartSec=30
UMask=0077
# Resource caps: well inside edgelab.slice, so it can never starve the collector or Chase Upside.
MemoryHigh=96M
MemoryMax=128M
CPUQuota=10%
TasksMax=8
Nice=10
# Read-only data: ProtectSystem=strict, and the stores are opened with SQLite mode=ro plus
# query_only. The evidence DB runs in WAL mode, and a reader must create -wal/-shm when no writer
# holds them (ADR 0016); without that, every read fails "unable to open database file" once the last
# collector connection has closed (production 2026-09-24). So the db directory is writable, but the
# database file is re-pinned read-only by the kernel (the more specific path wins). The odds quota
# ledger is NOT pinned: the odds runner replaces it by atomic rename, after which a pin no longer
# holds in this long-running process. The shadow ledger uses a rollback journal and needs no write
# access. After a restore that replaces edge_lab.sqlite3 by rename, restart the dashboard so the
# read-only pin applies again. Loopback traffic only, enforced by the kernel.
ReadWritePaths=/var/lib/market-edge-lab/db
ReadOnlyPaths=-/var/lib/market-edge-lab/db/edge_lab.sqlite3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
