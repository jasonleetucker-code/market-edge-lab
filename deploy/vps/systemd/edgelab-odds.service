[Unit]
Description=Market Edge Lab: The Odds API NFL pilot tick (read-only odds, 450-credit monthly ceiling)
Documentation=file:///opt/market-edge-lab/app/docs/decisions/0029-game-relative-odds-capture.md
After=network-online.target
Wants=network-online.target
OnFailure=edgelab-alert@%n.service

[Service]
Type=oneshot
Slice=edgelab.slice
User=edgelab
Group=edgelab
EnvironmentFile=/etc/market-edge-lab/env
# Owner-installed secrets (ADR 0028): EDGE_LAB_ODDS_API_KEY. Optional: without the key the
# tick prints SETUP_NEEDED and exits 0 without sending anything.
EnvironmentFile=-/etc/market-edge-lab/secrets.env
WorkingDirectory=/var/lib/market-edge-lab
# Resource bound: at most three GETs per tick (free events discovery, a free sports-list
# reconcile only if the quota is unknown, and ONE paid odds call when a slot is due), each one
# attempt with a 20 s timeout and no redirects. Payloads are tens of kilobytes.
ExecStart=/opt/market-edge-lab/venv/bin/python -m edge_lab.cli odds run --db /var/lib/market-edge-lab/db/edge_lab.sqlite3 --ledger /var/lib/market-edge-lab/db/odds_quota_ledger.json --sport americanfootball_nfl --markets h2h,spreads,totals --regions us
TimeoutStartSec=3min
UMask=0077
MemoryHigh=128M
MemoryMax=256M
CPUQuota=10%
TasksMax=16
Nice=10
# Filesystem and privilege hardening: writes only its own data and status directories.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/market-edge-lab /var/lib/market-edge-lab-status
