[Unit]
Description=Market Edge Lab: isolated Kalshi executor (DISARMED at every start; FIXTURE only; NOT INSTALLED)
Documentation=file:///opt/market-edge-lab-exec/app/docs/execution/runbooks/START_DISARMED.md
OnFailure=edgelab-alert@%n.service
StartLimitIntervalSec=600
StartLimitBurst=3

# Package O (ADR 0048). Shipped DISABLED: this file lives in the repository only. Nothing installs it: install.sh
# copies deploy/vps/systemd/ only, and this unit has no [Install] section, so `systemctl enable` cannot enable it
# even after a copy. Installing it and starting it are separate owner approvals (docs/execution/runbooks/INSTALL.md,
# START_DISARMED.md).
#
# Every start is DISARMED: the executor boots only through control.boot, which persists `Started` before anything
# acts, and only an operator's recorded arm request changes the mode (ADR 0046). A restart by systemd is a start.
# `ops run` first checks the release manifest against the installed REVISION and the journal's schema, then exits 78
# (no networked runner exists in this package yet); 78 is never restarted.
#
# Identity and privileges: its own system user, its own data, no research data, no research secrets, no key (a key
# arrives only with the DEMO approval, as LoadCredential=, never as a file this user owns), no capabilities and no
# network at all: FIXTURE needs none. Opening egress is part of the DEMO approval, never a configuration change.
[Service]
Type=simple
Slice=edgelab-exec.slice
User=edgelab-exec
Group=edgelab-exec
WorkingDirectory=/var/lib/market-edge-lab-exec
ExecStart=/opt/market-edge-lab-exec/venv/bin/python -m edge_lab.execution.ops run --manifest /etc/market-edge-lab-exec/release.json --revision-file /opt/market-edge-lab-exec/app/REVISION --journal /var/lib/market-edge-lab-exec/journal/kalshi.execution.sqlite3
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=78
TimeoutStopSec=60
UMask=0077
# Resources: inside edgelab-exec.slice, with headroom for reconciliation and cancels under load.
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
TasksMax=32
LimitNOFILE=1024
# Filesystem: writes only its journal and its status export; research data, research secrets, its own backups and
# the credentials directory are invisible to it.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/market-edge-lab-exec /var/lib/market-edge-lab-exec-status
InaccessiblePaths=-/var/lib/market-edge-lab -/etc/market-edge-lab -/var/lib/market-edge-lab-exec-backup -/etc/market-edge-lab-exec/credentials
# Egress: none (FIXTURE). Kernel-enforced, whatever the code does.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# Privileges.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
